import os
import json
import logging
from datetime import datetime, timezone

import pandas as pd
import pyarrow as pa
import pyarrow.parquet as pq

# ─────────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────────
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s - %(name)s - %(levelname)s - %(message)s",
)
logger = logging.getLogger("SocialMediaGold")

GOLD_VERSION = "1.0"

# ─────────────────────────────────────────────────────────────────────────────
# PyArrow Schemas for Gold Aggregated Tables
# ─────────────────────────────────────────────────────────────────────────────
SCHEMA_SUBREDDIT_SENTIMENT = pa.schema([
    pa.field("subreddit",           pa.string(),  nullable=False),
    pa.field("total_posts",         pa.int64(),   nullable=False),
    pa.field("avg_sentiment",       pa.float64(), nullable=False),
    pa.field("positive_ratio",      pa.float64(), nullable=False),
    pa.field("negative_ratio",      pa.float64(), nullable=False),
    pa.field("total_engagement",    pa.int64(),   nullable=False), # score + comments
    pa.field("gold_processed_at",  pa.string(),  nullable=False),
])

SCHEMA_KEYWORD_SENTIMENT = pa.schema([
    pa.field("search_term",         pa.string(),  nullable=False),
    pa.field("total_posts",         pa.int64(),   nullable=False),
    pa.field("avg_sentiment",       pa.float64(), nullable=False),
    pa.field("avg_score",           pa.float64(), nullable=False),
    pa.field("gold_processed_at",  pa.string(),  nullable=False),
])

# ─────────────────────────────────────────────────────────────────────────────
# Aggregation Functions
# ─────────────────────────────────────────────────────────────────────────────
def agg_subreddit_sentiment(df: pd.DataFrame, gold_ts: str) -> pd.DataFrame:
    total_posts = len(df)
    
    # Calculate ratios
    df['is_pos'] = (df['sentiment_label'] == "Positive").astype(int)
    df['is_neg'] = (df['sentiment_label'] == "Negative").astype(int)
    df['engagement'] = df['score'] + df['num_comments']
    
    grp = df.groupby("subreddit", as_index=False).agg(
        total_posts       =("post_id", "count"),
        avg_sentiment     =("sentiment_polarity", "mean"),
        pos_count         =("is_pos", "sum"),
        neg_count         =("is_neg", "sum"),
        total_engagement  =("engagement", "sum")
    )
    
    grp["positive_ratio"] = (grp["pos_count"] / grp["total_posts"]).round(4)
    grp["negative_ratio"] = (grp["neg_count"] / grp["total_posts"]).round(4)
    grp["avg_sentiment"]  = grp["avg_sentiment"].round(4)
    grp["gold_processed_at"] = gold_ts
    
    return grp[["subreddit", "total_posts", "avg_sentiment", "positive_ratio", "negative_ratio", "total_engagement", "gold_processed_at"]]

def agg_keyword_sentiment(df: pd.DataFrame, gold_ts: str) -> pd.DataFrame:
    grp = df.groupby("search_term", as_index=False).agg(
        total_posts   =("post_id", "count"),
        avg_sentiment =("sentiment_polarity", "mean"),
        avg_score     =("score", "mean")
    )
    grp["avg_sentiment"] = grp["avg_sentiment"].round(4)
    grp["avg_score"] = grp["avg_score"].round(2)
    grp["gold_processed_at"] = gold_ts
    return grp

def main():
    gold_ts = datetime.now(timezone.utc).isoformat()
    logger.info("=" * 60)
    logger.info("Social Media Gold Aggregation — START")
    logger.info(f"Run timestamp : {gold_ts}")
    logger.info("=" * 60)

    silver_table_path = "./data_lake/silver/social_media/social_media_silver_table"
    gold_dir          = "./data_lake/gold/social_media/"

    if not os.path.exists(silver_table_path):
        logger.error(f"Silver social media table not found at: {silver_table_path}. Run social_media_silver.py first.")
        return

    logger.info(f"Reading Silver Parquet table: {silver_table_path}")
    try:
        silver_dataset = pq.read_table(silver_table_path)
        df = silver_dataset.to_pandas()
    except Exception as exc:
        logger.error(f"Failed to read Silver social media table: {exc}")
        return

    logger.info(f"Silver rows loaded: {len(df):,}")

    os.makedirs(gold_dir, exist_ok=True)

    # Perform aggregations
    sub_df = agg_subreddit_sentiment(df, gold_ts)
    key_df = agg_keyword_sentiment(df, gold_ts)

    # Write tables
    def write_table(agg_df, schema, name):
        out_path = os.path.join(gold_dir, f"{name}.parquet")
        try:
            table = pa.Table.from_pandas(agg_df, schema=schema, preserve_index=False)
        except Exception as exc:
            logger.warning(f"Schema cast failed for {name}: {exc}. Using inferred schema.")
            table = pa.Table.from_pandas(agg_df, preserve_index=False)
        pq.write_table(table, out_path, compression="snappy")
        logger.info(f"  ✓ [{name}] → {out_path} ({len(agg_df)} rows)")

    write_table(sub_df, SCHEMA_SUBREDDIT_SENTIMENT, "subreddit_sentiment")
    write_table(key_df, SCHEMA_KEYWORD_SENTIMENT, "keyword_sentiment")

    logger.info("=" * 60)
    logger.info("Social Media Gold Aggregation — COMPLETE")
    logger.info("=" * 60)

if __name__ == "__main__":
    main()
